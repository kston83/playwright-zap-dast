# Playwright ZAP DAST Configuration
# Copy this file to .env and update with your values

# ==============================================
# AUTHENTICATION SETTINGS (Required for authenticated scans)
# ==============================================
LOGIN_URL=https://your-app.com/login
LOGIN_EMAIL=test-user@example.com
LOGIN_PASSWORD=your-secure-password
COMMON_SELECTOR=.dashboard-content

# ==============================================
# ZAP CONFIGURATION
# ==============================================
ZAP_PROXY=http://localhost:8888
ZAP_API_KEY=
BASE_URL=https://your-app.com

# ==============================================
# SCAN MODE CONFIGURATION  
# ==============================================
# Options: true (authenticated), false (unauthenticated), mixed (both)
USE_AUTHENTICATION=true

# Scan timeouts (in milliseconds)
SPIDER_TIMEOUT=300000
ACTIVE_SCAN_TIMEOUT=600000
SCAN_DELAY=5000

# ==============================================
# BROWSER CONFIGURATION
# ==============================================
HEADLESS=false
BROWSER_TIMEOUT=60000

# ==============================================
# URL FILTERING (Optional)
# ==============================================
# Include only URLs matching this regex pattern
# URL_INCLUDE_PATTERN=admin|finance|reports

# Exclude URLs matching this regex pattern  
# URL_EXCLUDE_PATTERN=logout|delete|remove

# Limit number of URLs to scan (useful for testing)
# URL_LIMIT=5

# ==============================================
# ADVANCED SETTINGS
# ==============================================
# ZAP scan timeout
ZAP_TIMEOUT=60000

# Enable debug logging
# DEBUG=pw:api

# Node.js memory settings (for large scans)  
# NODE_OPTIONS=--max-old-space-size=4096